# A Kubernetes Secret filled from SOPS subtrees: readSopsData returns the
# map at /env and the list at /allowed_networks.
apiVersion: v1
kind: Secret
metadata:
  name: web-app-env
stringData:
{{- range $key, $value := readSopsData "sops://services/web-app/secrets.sops.yaml#/env" }}
  {{ $key }}: {{ $value | quote }}
{{- end }}
  ALLOWED_NETWORKS: |
{{- range readSopsData "sops://services/web-app/secrets.sops.yaml#/allowed_networks" }}
    {{ . }}
{{- end }}
