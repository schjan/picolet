hostname: "{{ .Host.Hostname }}"
repo_url: "https://github.com/example/fleet.git"
listen_addr: 127.0.0.1:{{ .Host.ListenPort }}
{{- if .Host.AgeRecipients }}
# The Host declares age_recipients:, so its Agent decrypts sops:// refs with
# the identity delivered as the --secrets-dir file age-identity.
sops:
  age_identity_path: /etc/picolet/secrets/age-identity
{{- end }}
