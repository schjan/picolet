groups:
  - name: instance_alerts
    rules:
      - alert: InstanceDown
        expr: up == 0
        for: 5m
        annotations:
          summary: "{{ $labels.instance }} of job {{ $labels.job }} is down"
  - name: node_uptime_alerts
    rules:
      - alert: NodeUptimeLow
        expr: node_time_seconds - node_boot_time_seconds < 600
        for: 2m
        annotations:
          summary: "Node {{ $labels.instance }} restarted recently"
