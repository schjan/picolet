# A Kubernetes Secret filled from SOPS subtrees: readSopsData returns the
# map at /env and the list at /allowed_networks.
apiVersion: v1
kind: Secret
metadata:
  name: web-app-env
stringData:
  API_TOKEN: "<sops-secret>"
  SESSION_KEY: "<sops-secret>"
  ALLOWED_NETWORKS: |
    <sops-secret>
    <sops-secret>
