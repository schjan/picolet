# A Kubernetes Secret filled from SOPS subtrees: readSopsData returns the
# map at /env and the list at /allowed_networks.
apiVersion: v1
kind: Secret
metadata:
  name: web-app-env
stringData:
  API_TOKEN: "TEST-ONLY-web-app-api-token"
  SESSION_KEY: "TEST-ONLY-web-app-session-key"
  ALLOWED_NETWORKS: |
    10.0.0.0/24
    192.168.10.0/24
