# The backup bundle's alert rules (docs/alerting.md "Alerting on timer-triggered
# one-shots"): no success of backup.service for twice its daily schedule. The
# metrics bundle's rules.yml.tmpl composes this snippet on the Host carrying
# both, whose own Agent reports the unit; host= is the label its scrape job
# (scrape/picolet.yml.tmpl) puts on that Agent's series.
- name: backup
  rules:
    - alert: PicoletOneShotStale
      expr: time() - picolet_unit_last_success_timestamp_seconds{host="{{ .Host.Hostname }}", unit="backup.service"} > 2 * 86400
      for: 15m
      labels:
        severity: warning
        schedule: daily
      annotations:
        summary: backup.service on {{ .Host.Hostname }} has not succeeded for over two days
        description: Check picolet_unit_last_result and `journalctl --user -u backup.service`.
    - alert: PicoletOneShotSuccessAbsent
      expr: absent_over_time(picolet_unit_last_success_timestamp_seconds{host="{{ .Host.Hostname }}", unit="backup.service"}[2d])
      labels:
        severity: warning
        schedule: daily
      annotations:
        summary: No success of backup.service on {{ .Host.Hostname }} reported for two days
        description: It has never succeeded, has not succeeded since an Agent or Machine restart, or the Agent is not being scraped.
