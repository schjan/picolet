# Forgejo settings of Host {{ .Host.Hostname }} (forge bundle), applied to
# app.ini on every container start. No secrets here: Forgejo generates its own
# on first start and keeps them in the config volume.
FORGEJO__server__DOMAIN={{ .Host.ExternalHostname }}
FORGEJO__server__ROOT_URL=https://{{ .Host.ExternalHostname }}/
FORGEJO__server__HTTP_PORT=3000
# Clone over HTTPS through the proxy; no SSH port to publish.
FORGEJO__server__DISABLE_SSH=true
# A file-based database: back it up with `forgejo dump`, never by copying it.
FORGEJO__database__DB_TYPE=sqlite3
FORGEJO__database__PATH=/var/lib/gitea/data/forgejo.db
# No web installer and no self-registration on a public hostname: create the
# first admin with `forgejo admin user create` in the container.
FORGEJO__security__INSTALL_LOCK=true
FORGEJO__service__DISABLE_REGISTRATION=true
FORGEJO__metrics__ENABLED=true
FORGEJO__actions__ENABLED=true
