[Unit]
Description=Register the CI runner with the forge (one-shot)
After=network-online.target
Wants=network-online.target

[Container]
Image={{ index .Images "runner" }}
ContainerName=runner-register
Network=runner.network
# Rootless: uid 0 in the container is the runner user, like in runner.container.
User=0
# The forge's registration token (secrets/runner_token.tmpl), at
# /run/secrets/runner_token.
Secret=runner_token
Volume={{ filePath "runner" }}:/etc/runner:ro
Volume=runner-data.volume:/data
Exec=/bin/sh /etc/runner/register.sh

[Service]
# Runs once and then stays "active (exited)": starting runner.service (which
# Wants= it) does not register again, and the health loop counts it healthy.
# Picolet restarts it - re-running register.sh - when this unit changes, and
# the runner-registration hook does when runner_token or register.sh changes;
# systemd carries that restart over to runner.service (PartOf=). register.sh
# skips a forge URL and token it already registered with, so a reboot adds no
# runner to the forge.
Type=oneshot
RemainAfterExit=yes
# The forge is on another Host and may be down. The health loop restarts a
# failed registration, but only every 5 minutes; retry sooner here.
Restart=on-failure
RestartSec=30
TimeoutStartSec=120

[Install]
WantedBy=default.target
