[Unit]
Description=CI runner (jobs run on this user's Podman)
# Registered first: Wants=, not Requires=, so a failed registration attempt
# (forge down) does not leave the daemon stopped for good - it keeps
# restarting below until the registration lands. PartOf= carries a restart of
# the registration (token rotation) over to this unit.
Wants=runner-register.service network-online.target podman.socket
After=runner-register.service network-online.target podman.socket
PartOf=runner-register.service
# Until runner-register has written /data/.runner, the daemon exits at start:
# keep retrying (RestartSec= below), without a start-rate limit that would
# leave it failed.
StartLimitIntervalSec=0

[Container]
Image={{ index .Images "runner" }}
ContainerName=runner
Network=runner.network
Exec=forgejo-runner --config /etc/runner/config.yml daemon

# Rootless: uid 0 in the container is the runner user, which may use the
# user's Podman socket. The image default (uid 1000) could not.
User=0
SecurityLabelDisable=true
Volume={{ filePath "runner" }}:/etc/runner:ro
Volume=runner-data.volume:/data
# The socket at the same path as on the Machine: the runner passes that path to
# Podman as the bind source of each job container's /var/run/docker.sock
# (config.yml docker_host: automount), and Podman resolves it on the Machine.
Volume=%t/podman/podman.sock:%t/podman/podman.sock
Environment=DOCKER_HOST=unix://%t/podman/podman.sock

[Service]
Restart=always
RestartSec=30
TimeoutStartSec=90

[Install]
WantedBy=default.target
