# Agent runtime configuration
# Rootful: /etc/picolet/config.yml
# Rootless: ~/.config/picolet/config.yml

# Required: must exactly match hosts/<name>/host.yml in the fleet repo
hostname: "rpi5-1"

# Required: HTTPS URL (SSH is not supported)
repo_url: "https://github.com/yourorg/your-fleet-repo.git"

repo_branch: "main"
poll_interval: "60s"
metrics_port: 9417
secrets_dir: "/etc/picolet/secrets"

# Rootless mode: compute file paths relative to $HOME (~/.config/..., ~/.local/share/...).
# Use when running picolet directly on the host without a container.
# Default: false (rootful paths: /etc/..., /var/lib/...)
rootless: false

# Connect to the user systemd instance (private socket) instead of system D-Bus.
# Required when picolet manages a rootless Podman host — regardless of whether
# picolet itself runs in a container or directly.
# Default: inherits from rootless
# systemd_user: true

# Podman API socket path (inside the container).
# Default: /run/podman/podman.sock (correct for both modes — volume mounts handle it)
# podman_socket: "/run/podman/podman.sock"

# GitHub authentication (for private repos):
# Create a PAT with Contents: Read-only scope:
#   Rootful:  echo "ghp_..." > /etc/picolet/secrets/git_token && chmod 600 ...
#   Rootless: echo "ghp_..." > ~/.config/picolet/secrets/git_token && chmod 600 ...
git_token_path: "/etc/picolet/secrets/git_token"
# For public repos: omit or leave empty
